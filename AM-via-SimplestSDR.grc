    state: enabled
- name: snippet_1
  id: snippet
  parameters:
    alias: ''
    code: "from gnuradio import qtgui\n\nhzPerMHz = 1000 * 1000\nunitSuffix = \"MHz\"\
      \n\nfor rngWidget in self.findChildren(qtgui.RangeWidget):\n  editBox = rngWidget.findChild(Qt.QLineEdit)\n\
      \  if editBox is None:\n    continue\n\n  origSetText = editBox.setText\n\n\
      \  def makeFormatter(box, setTextFn):\n    def formatMHz(rawText):\n      cleanText\
      \ = rawText.replace(unitSuffix, \"\").strip()\n      try:\n        hzVal = float(cleanText)\n\
      \        mhzVal = hzVal / hzPerMHz\n        setTextFn(f\"{mhzVal:.3f}{unitSuffix}\"\
      )\n      except ValueError:\n        setTextFn(rawText)\n    return formatMHz\n\
      \n  def makeParser(box, rngObj):\n    def parseTypedKhz():\n      txt = box.text().strip()\n\
      \      if txt.endswith(unitSuffix):\n        numPart = txt[:-len(unitSuffix)].strip()\n\
      \        try:\n          hzVal = float(numPart) * hzPerKhz\n          rngObj.d_rng.set(hzVal)\n\
      \        except ValueError:\n          pass\n    return parseTypedKhz\n\n  editBox.setText\
      \ = makeFormatter(editBox, origSetText)\n  editBox.editingFinished.connect(makeParser(editBox,\
      \ rngWidget))\n  editBox.setText(editBox.text())"
    comment: ''
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1608, 152.0]
    rotation: 0
    state: enabled

